# ── 한국투자증권 OpenAPI ─────────────────────────────
# https://apiportal.koreainvestment.com 에서 발급
# 모의투자용 키와 실전용 키는 서로 다릅니다!
KIS_ENV=paper                # paper(모의투자) | real(실전투자)
KIS_APP_KEY=발급받은_APP_KEY
KIS_APP_SECRET=발급받은_APP_SECRET
KIS_ACCOUNT_NO=12345678-01   # 계좌번호 (8자리-2자리)

# ── 텔레그램 ─────────────────────────────────────────
# 1) @BotFather 에게 /newbot 으로 봇 생성 → 토큰 복사
# 2) 만든 봇에게 아무 메시지 전송 후
#    https://api.telegram.org/bot<토큰>/getUpdates 에서 chat.id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 구글 스프레드시트 ────────────────────────────────
# 시트 URL: https://docs.google.com/spreadsheets/d/<이부분>/edit
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ── 동작 옵션 ────────────────────────────────────────
DRY_RUN=true                 # true면 실제 주문 없이 알림/기록만 (첫 테스트용)
